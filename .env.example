# Copy to .env. Every value is optional.

TZ=UTC
# AUTO_MERGE=false        # true = merge every detected pair without a click
# DELETE_SOURCE=true      # delete the Zwift copy on Garmin after merging
# COPY_ALTITUDE=false     # also copy the Zwift virtual altitude
# SCAN_DAYS=7
# SCAN_INTERVAL_MINUTES=30
# MIN_OVERLAP=0.5
# MIN_POSITION_RATIO=0.5
# TIME_TOLERANCE_S=2
# SOURCE_NAMES=zwift
# SOURCE_MANUFACTURERS=260
# APP_PASSWORD=           # protects the web UI (HTTP Basic, any user name)
# GARMIN_EMAIL=           # automatic login at startup (accounts without MFA)
# GARMIN_PASSWORD=
# LOG_LEVEL=INFO
# ZWIFT_EMAIL=            # automatic Zwift login at startup (or connect in the web UI)
# ZWIFT_PASSWORD=
# ZWIFT_AUTO_SYNC=true    # fetch new Zwift activities at each scan when Zwift is connected
